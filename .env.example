# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=

# Optional overrides. Defaults are listed in docs/CONTRACT.md section 8.
# GNANI_STT_FORMAT=transliterate
# GNANI_STT_LANGUAGE=hi-IN
# GNANI_TTS_VOICE=Shivani

# 32 random bytes, base64. If empty, the server creates data/ledger.key on first run.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LEDGER_KEY=

# Protects POST /api/admin/purge. Leave empty to disable that endpoint.
ADMIN_TOKEN=

# If set, the web app must send this code before a session starts (protects your Gnani credits on a public URL).
ACCESS_CODE=
