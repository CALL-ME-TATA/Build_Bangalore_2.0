# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=

# Optional overrides. Defaults are listed in docs/CONTRACT.md section 8.
# GNANI_STT_FORMAT=transliterate
# GNANI_STT_LANGUAGE=hi-IN
# GNANI_TTS_VOICE=Shivani

# Safety questions, both on by default. Set to 0 to switch one off.
# CONFIRM_NEW_CUSTOMER=1   # ask before opening an account for a name that is not in the ledger
# STRICT_SAVE=1            # ask before saving a sentence that holds a word the parser does not know

# 32 random bytes, base64. If empty, the server creates data/ledger.key on first run.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LEDGER_KEY=

# Protects POST /api/admin/purge. Leave empty to disable that endpoint.
ADMIN_TOKEN=

# If set, the web app must send this code before a session starts (protects your Gnani credits on a public URL).
ACCESS_CODE=

# Noise handling (CONTRACT 3.5). Turn down what is clearly not the speaker (1) or never (0).
NOISE_TRIM=
# Separation in dB below which the turn-down gives up and every frame passes unchanged (default 16).
NOISE_TRIM_DB=
# Separation in dB below which a spoken entry is confirmed before it is saved (default 14; 0 switches this off).
NOISE_CONFIRM_DB=

# LLM fallback (server/app/llm.py): only sentences the rules refuse are rewritten by the LLM and parsed again;
# any entry from that path is read back and saved only after a yes. Empty key = rules only.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible host, e.g. https://api.cerebras.ai/v1
# LLM_MODEL=qwen/qwen3.8-27b                    # measured fastest correct on Groq (~140 ms median)
# LLM_REASONING_EFFORT=none                     # empty to not send it (hosts that reject the field)
# LLM_TIMEOUT_S=1.5                             # on timeout the original refusal is kept

# Google sign-in (server/app/auth.py). Set both to require sign-in for the khata; leave empty to keep it open.
# Redirect URI to register in Google Cloud: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated. Only these Google accounts can open the khata; empty = nobody.
ALLOWED_EMAILS=
# SESSION_SECRET=        # empty: a random key is kept in data/session.key
# PUBLIC_URL=            # behind a tunnel, e.g. https://my-tunnel.trycloudflare.com (also register its callback)

# Kafka notifications (server/app/notify.py). Start a broker with `docker compose up -d kafka`, then set:
# KAFKA_BOOTSTRAP=localhost:9094
# KAFKA_TOPIC=khata.notifications
